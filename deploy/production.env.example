NODE_ENV=production
HOST=127.0.0.1
PORT=5000

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=mantenimiento_app
DB_PASSWORD=REEMPLAZAR_CON_CLAVE_ALEATORIA_DE_32_CARACTERES
DB_NAME=mantenimiento

CORS_ORIGINS=https://mantenimiento.example.com
SESSION_HOURS=8
MAX_UPLOAD_MB=10
IMAGE_MAX_DIMENSION=1920
IMAGE_WEBP_QUALITY=76
IMAGE_MAX_MEGAPIXELS=40
API_RATE_LIMIT=600
EDGE_RATE_LIMIT=1200
UPLOAD_RATE_LIMIT=30
UPLOAD_CONCURRENCY=2
LOGIN_RATE_LIMIT=10
LOGIN_IP_RATE_LIMIT=50
TRUST_PROXY_HOPS=1
ALLOW_MULTIPLE_DAILY_INSPECTIONS=false

GEMINI_API_KEY=REEMPLAZAR_CON_CLAVE_DE_GEMINI

MAX_VIDEO_MB=100
# Opcional: lectura del kilometraje desde TTS con un usuario de solo lectura.
TTS_DATABASE_URL=postgresql://mantencion_lectura:CLAVE@127.0.0.1:5432/BASE_TTS
TTS_SYNC_MINUTES=60

# WhatsApp automático (Evolution API). Vacías = la app abre WhatsApp a mano.
EVOLUTION_API_URL=
EVOLUTION_INSTANCE=
EVOLUTION_API_KEY=
# Clave del webhook para aprobar respondiendo «APROBAR 12» (24-128 letras, números, _ o -). Vacía = apagado.
# Webhook a configurar en Evolution: https://<dominio>/api/whatsapp/webhook/<esta clave>  (evento MESSAGES_UPSERT)
WHATSAPP_WEBHOOK_TOKEN=
